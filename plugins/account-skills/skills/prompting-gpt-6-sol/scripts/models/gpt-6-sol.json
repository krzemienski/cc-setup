{
  "vendor": "openai",
  "endpoint": "https://api.openai.com/v1/responses",
  "auth": {
    "header": "authorization",
    "scheme": "Bearer",
    "env": "OPENAI_API_KEY",
    "base_url_env": "KIT_OPENAI_BASE_URL"
  },
  "fixed_headers": {
    "content-type": "application/json"
  },
  "context_tokens": 1050000,
  "max_output_tokens": 128000,
  "long_context_surcharge": {
    "over_input_tokens": 272000,
    "input_multiplier": 2.0,
    "output_multiplier": 1.5
  },
  "sampling_params": {
    "keys": [
      "temperature",
      "top_p",
      "top_logprobs",
      "logprobs"
    ],
    "allowed_only_at_effort": "none"
  },
  "cache": {
    "param": "prompt_cache_options",
    "value": {
      "ttl": "30m"
    },
    "replaced": "prompt_cache_retention"
  },
  "max_output_defaults": {
    "chat": 25000,
    "long": 64000,
    "agent": 128000
  },
  "_max_output_why": "OpenAI's reasoning guide recommends reserving at least 25,000 tokens for reasoning and outputs when starting out.",
  "blocks": {
    "instructions_when_input": [
      "gpt6-pasted-content-note"
    ],
    "working_chat": [
      "gpt6-instruction-precedence"
    ],
    "working_action": [
      "gpt6-initiative",
      "gpt6-act-on-requests",
      "gpt6-reviewable-result",
      "gpt6-instruction-precedence"
    ],
    "working_agent_extra": [
      "gpt6-skill-debug",
      "gpt6-delegation",
      "gpt6-testing"
    ],
    "writing_prose": [
      "gpt6-writing-style",
      "gpt6-stock-phrases"
    ],
    "writing_technical": [
      "gpt6-technical-communication"
    ],
    "harness_continuation": "continuation-open-items"
  },
  "sources": {
    "guide": "https://developers.openai.com/api/docs/guides/latest-model/gpt-6-astra.md",
    "reasoning": "https://developers.openai.com/api/docs/guides/reasoning",
    "skills": "https://developers.openai.com/blog/rethinking-skills-and-prompts-for-gpt-6-astra",
    "model_page": "https://developers.openai.com/api/docs/models/gpt-6-sol",
    "announcement": "https://openai.com/index/introducing-gpt-6-sol-and-luna/"
  },
  "verified": "2026-09-28",
  "id": "gpt-6-sol",
  "display": "GPT-6 Sol",
  "efforts": [
    "none",
    "low",
    "medium",
    "high",
    "xhigh",
    "max"
  ],
  "default_effort": "medium",
  "effort_guidance": {
    "start": "medium",
    "try_lower": "low",
    "reserve": [
      "xhigh",
      "max"
    ],
    "_why": "Model page default is medium. none disables reasoning and is the only level where sampling parameters and Chat Completions function calling are allowed."
  },
  "knowledge_cutoff": "2026-04-20",
  "pricing_usd_per_mtok": {
    "input": 2.0,
    "cached_input": 0.2,
    "cache_write": 2.5,
    "output": 10.0
  },
  "chat_completions_tools": "only_at_none",
  "use_for": "demanding professional work at one fifth of Astra's price: business workflows, coding agents, automation",
  "max_output_warn": {
    "below": 25000,
    "at_efforts": [
      "medium",
      "high",
      "xhigh",
      "max"
    ]
  }
}

{
  "vendor": "anthropic",
  "endpoint": "https://api.anthropic.com/v1/messages",
  "auth": {
    "header": "x-api-key",
    "env": "ANTHROPIC_API_KEY",
    "base_url_env": "KIT_ANTHROPIC_BASE_URL"
  },
  "fixed_headers": {
    "anthropic-version": "2023-06-01",
    "content-type": "application/json"
  },
  "efforts": [
    "low",
    "medium",
    "high",
    "xhigh",
    "max"
  ],
  "context_tokens": 1000000,
  "max_output_tokens": 128000,
  "min_cacheable_tokens": 512,
  "thinking": {
    "always_on": true,
    "send": {
      "type": "adaptive"
    },
    "forbidden_types": [
      "disabled",
      "enabled"
    ],
    "forbidden_keys": [
      "budget_tokens"
    ]
  },
  "forbidden_tool_choice": [
    "any",
    "tool"
  ],
  "structured_output": {
    "param": "output_config.format",
    "shape": {
      "type": "json_schema"
    }
  },
  "betas": {
    "display_updates": "thinking-display-updates-2026-08-18",
    "turn_scoped_system": "mid-conversation-system-clear-at-2026-08-21",
    "per_message_effort": "mid-conversation-output-config-2026-07-01",
    "thinking_binding": "thinking-binding-controls-2026-08-01"
  },
  "max_tokens_defaults": {
    "chat": 16000,
    "long": 64000,
    "agent": 128000,
    "_why": "Thinking counts toward max_tokens. 16K leaves room for thinking plus a one-page reply; 64K for long documents; 128K is the model maximum Anthropic reports working well for long agentic turns."
  },
  "max_tokens_warn_below": 16000,
  "blocks": {
    "system_when_input": [
      "pasted-content-note"
    ],
    "system_chat": [],
    "system_agent_before_tail": [
      "progress-updates-request"
    ],
    "user_prose": [
      "mannered-prose"
    ],
    "user_long_effort": [
      "one-limit-note"
    ],
    "harness_batch_nudge": null,
    "harness_silent_reminder": "silent-stretch-reminder",
    "harness_continuation": "continuation-open-items"
  },
  "lint": {
    "anti_formatting_block_warn": false,
    "compile_check_warn": false
  },
  "id": "claude-opus-5-5",
  "display": "Claude Opus 5.5",
  "default_effort": "medium",
  "effort_guidance": {
    "start": "medium",
    "try_lower": "low",
    "reserve": [
      "xhigh",
      "max"
    ],
    "_why": "Anthropic: Opus 5.5 at medium matched or exceeded Opus 5 at high on coding and knowledge-work evals; low came close on several coding evals. Reserve xhigh/max for measured gains."
  },
  "pricing_usd_per_mtok": {
    "input": 4.0,
    "output": 20.0,
    "cache_write_5m": 5.0,
    "cache_write_1h": 8.0,
    "cache_read": 0.2,
    "batch_input": 2.0,
    "batch_output": 10.0
  },
  "sampling_params": {
    "keys": [
      "temperature",
      "top_p",
      "top_k"
    ],
    "level": "WARN",
    "why": "Thinking is always on; Anthropic's Opus 5.5 pages retrieved do not state the sampling-parameter rule explicitly, but Fable 5.1's page documents non-default values returning 400 with always-on thinking. Remove them."
  },
  "forbidden_tool_types": [
    "computer_20251124"
  ],
  "refusal_fallback_targets": null,
  "blocks_tail_agent": [
    "opus-unattended-standing-instruction"
  ],
  "sources": {
    "prompting": "https://platform.claude.com/docs/en/build-with-claude/prompt-engineering/prompting-claude-opus-5-5",
    "whats_new": "https://platform.claude.com/docs/en/models/opus-5-5/whats-new-opus-5-5",
    "effort": "https://platform.claude.com/docs/en/build-with-claude/effort",
    "best_practices": "https://platform.claude.com/docs/en/build-with-claude/prompt-engineering/claude-prompting-best-practices",
    "structured_outputs": "https://platform.claude.com/docs/en/build-with-claude/structured-outputs"
  },
  "verified": "2026-09-28"
}
